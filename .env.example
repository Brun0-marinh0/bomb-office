# Copie para .env e ajuste. O .env não vai para o git.

# Versão do Godot usada para exportar e rodar o servidor
GODOT_VERSION=4.3

# Porta do site (http://SEU-IP:WEB_PORT)
WEB_PORT=8060

# Porta do servidor do jogo. Mantenha 9080: na rede local o navegador conecta em ws://IP:9080
GAME_PORT=9080

# Link exibido no lobby em "Convide pelo link" (rede local: http://SEU-IP:WEB_PORT/)
# Deixe vazio para usar o endereço da própria página.
SHARE_URL=http://SEU-IP:8060/

# Só para o perfil https (VPS): domínio apontando para o servidor. Ex.: jogo.exemplo.com
DOMAIN=
